[Unit]
Description=USB-C Daemon
Documentation=https://github.com/your-repo/usbcd
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/etc
ExecStart=/usr/local/bin/usbcd
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
